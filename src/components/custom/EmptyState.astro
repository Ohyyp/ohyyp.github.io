---
import { Icon } from "astro-icon/components";

interface Props {
	message: string;
	icon?: string;
	actionLabel?: string;
	actionHref?: string;
	card?: boolean;
}

const {
	message,
	icon = "material-symbols:inbox-outline-rounded",
	actionLabel,
	actionHref,
	card = true,
} = Astro.props;
---
<div
    class:list={[
        "text-center flex flex-col items-center justify-center onload-animation",
        card
            ? "card-base rounded-[var(--radius-large)] px-8 py-12"
            : "px-4 py-10",
    ]}
>
    <Icon name={icon} class="text-5xl text-black/20 dark:text-white/20 mb-3" />
    <p class="text-50 text-sm md:text-base">{message}</p>
    {actionLabel && actionHref && (
        <a
            href={actionHref}
            class="btn-regular inline-flex px-4 h-10 rounded-lg font-bold text-sm mt-4"
        >
            {actionLabel}
        </a>
    )}
</div>
