---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { postFeatureConfig, siteConfig } from "@/config";
import type { Locale } from "@/types/config";

interface Props {
	headings: MarkdownHeading[];
	lang: Locale;
}

const { headings = [], lang } = Astro.props;
let minDepth = 10;
for (const h of headings) {
	minDepth = Math.min(minDepth, h.depth);
}
const maxLevel = siteConfig.toc.depth;
const visibleHeadings = headings.filter((h) => h.depth < minDepth + maxLevel);
---
{postFeatureConfig.mobileToc && siteConfig.toc.enable && visibleHeadings.length > 0 && (
    <details class="2xl:hidden mb-6 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] px-4 py-3 onload-animation">
        <summary class="cursor-pointer font-bold text-sm text-75 flex items-center gap-2 select-none list-none">
            <Icon name="material-symbols:toc-rounded" class="text-lg text-[var(--primary)]" />
            <span>{i18n(I18nKey.tableOfContents, lang)}</span>
        </summary>
        <nav class="mt-3 flex flex-col gap-1.5 border-t border-black/10 dark:border-white/10 pt-2.5">
            {visibleHeadings.map((heading) => (
                <a
                    href={`#${heading.slug}`}
                    class:list={[
                        "text-sm text-50 hover:text-[var(--primary)] transition py-0.5 truncate",
                        {
                            "pl-0 font-medium": heading.depth === minDepth,
                            "pl-4": heading.depth === minDepth + 1,
                            "pl-8 text-xs": heading.depth >= minDepth + 2,
                        },
                    ]}
                >
                    {heading.text.replace(/#$/, "")}
                </a>
            ))}
        </nav>
    </details>
)}
