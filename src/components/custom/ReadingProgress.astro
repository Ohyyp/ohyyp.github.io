---
interface Props {
	isPostPage?: boolean;
}

const { isPostPage = false } = Astro.props;
---
<div
    id="reading-progress"
    aria-hidden="true"
    class:list={[
        "fixed top-0 left-0 h-[3px] w-0 bg-[var(--primary)] z-[60] transition-[width] duration-75 pointer-events-none",
        { hidden: !isPostPage },
    ]}
></div>

<script>
	declare global {
		interface Window {
			__readingProgressBound?: boolean;
		}
	}

	function updateReadingProgress() {
		const bar = document.getElementById("reading-progress");
		if (!bar) return;
		const isPost =
			document.getElementById("content-wrapper")?.getAttribute("data-is-post") ===
			"true";
		if (!isPost) {
			bar.classList.add("hidden");
			bar.style.width = "0%";
			return;
		}
		bar.classList.remove("hidden");
		const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
		const scrollHeight =
			document.documentElement.scrollHeight - window.innerHeight;
		if (scrollHeight <= 0) {
			bar.style.width = "0%";
			return;
		}
		const pct = Math.min(100, Math.max(0, (scrollTop / scrollHeight) * 100));
		bar.style.width = `${pct.toFixed(1)}%`;
	}

	updateReadingProgress();

	if (!window.__readingProgressBound) {
		window.__readingProgressBound = true;
		window.addEventListener("scroll", updateReadingProgress, { passive: true });
		window.addEventListener("resize", updateReadingProgress, { passive: true });
		const bindSwup = () => {
			window.swup?.hooks?.on("page:view", () => {
				updateReadingProgress();
				setTimeout(updateReadingProgress, 50);
			});
		};
		if (window.swup?.hooks) {
			bindSwup();
		} else {
			document.addEventListener("swup:enable", bindSwup);
		}
	}
</script>
