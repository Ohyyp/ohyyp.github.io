---
import EmptyState from "@components/custom/EmptyState.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getLocalizedPath, pickLocalized } from "@utils/i18n-utils";
import { Icon } from "astro-icon/components";
import { featurePagesConfig } from "@/config";
import { type ProjectItem, projects } from "@/data/projects";
import type { Locale } from "@/types/config";

interface Props {
	lang: Locale;
	items?: ProjectItem[];
}

const { lang, items = projects } = Astro.props;
---
{!featurePagesConfig.projects ? (
    <EmptyState
        message={i18n(I18nKey.pageDisabled, lang)}
        actionLabel={i18n(I18nKey.backHome, lang)}
        actionHref={getLocalizedPath("/", lang)}
    />
) : (
    <div class="flex flex-col gap-4 onload-animation">
        <div class="card-base rounded-[var(--radius-large)] px-7 py-6">
            <h1 class="text-2xl font-bold text-90 relative before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-1.5 before:-left-4">
                {i18n(I18nKey.projects, lang)}
            </h1>
        </div>

        {items.length === 0 ? (
            <EmptyState message={i18n(I18nKey.noProjects, lang)} />
        ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {items.map((project) => (
                <div class="card-base rounded-[var(--radius-large)] p-6 flex flex-col justify-between gap-4">
                    <div>
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <h2 class="text-lg font-bold text-90">
                                {pickLocalized(project.title, "", lang)}
                            </h2>
                            <span class="shrink-0 px-2.5 py-0.5 rounded-md text-xs font-bold bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
                                {pickLocalized(project.status, "", lang)}
                            </span>
                        </div>
                        <p class="text-sm text-75 leading-relaxed mb-4">
                            {pickLocalized(project.summary, "", lang)}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                            {project.techStack.map((tech) => (
                                <span class="px-2 py-0.5 rounded-md text-xs bg-black/[0.04] dark:bg-white/[0.08] text-50">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-2 pt-2 border-t border-black/5 dark:border-white/10">
                        {project.repoUrl && (
                            <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-regular h-8 px-3 rounded-lg text-xs font-bold gap-1.5 active:scale-95">
                                <Icon name="fa6-brands:github" class="text-sm" />
                                <span>{i18n(I18nKey.sourceCode, lang)}</span>
                            </a>
                        )}
                        {project.liveUrl && (
                            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-plain h-8 px-3 rounded-lg text-xs font-bold gap-1.5 text-[var(--primary)] active:scale-95">
                                <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs" />
                                <span>{i18n(I18nKey.liveDemo, lang)}</span>
                            </a>
                        )}
                    </div>
                </div>
            ))}
        </div>
        )}
    </div>
)}
