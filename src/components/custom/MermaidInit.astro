<script>
	declare global {
		interface Window {
			__mermaidInitBound?: boolean;
		}
	}

	function extractMermaidSource(pre: Element): string {
		const lines = pre.querySelectorAll(".ec-line .code");
		if (lines.length > 0) {
			return Array.from(lines)
				.map((line) => (line.textContent ?? "").replace(/\n$/, ""))
				.join("\n")
				.trim();
		}
		return (pre.textContent ?? "").trim();
	}

	async function renderMermaidDiagrams() {
		const codeBlocks = Array.from(
			document.querySelectorAll('.expressive-code pre[data-language="mermaid"]'),
		);
		const existingDiagrams = Array.from(
			document.querySelectorAll(".mermaid-diagram[data-mermaid-src]"),
		);

		if (codeBlocks.length === 0 && existingDiagrams.length === 0) {
			return;
		}

		const { default: mermaid } = await import("mermaid");
		const isDark = document.documentElement.classList.contains("dark");
		mermaid.initialize({
			startOnLoad: false,
			theme: isDark ? "dark" : "default",
			securityLevel: "strict",
		});

		for (const pre of codeBlocks) {
			const src = extractMermaidSource(pre);
			if (!src) continue;
			const wrapper = pre.closest(".expressive-code") || pre;
			const container = document.createElement("div");
			container.className =
				"mermaid-diagram my-6 flex justify-center overflow-x-auto rounded-xl p-4 bg-black/[0.03] dark:bg-white/[0.04]";
			container.setAttribute("data-mermaid-src", src);
			wrapper.replaceWith(container);
			existingDiagrams.push(container);
		}

		for (let i = 0; i < existingDiagrams.length; i++) {
			const el = existingDiagrams[i] as HTMLElement;
			const src = el.getAttribute("data-mermaid-src");
			if (!src) continue;
			const renderId = `mermaid-svg-${Date.now()}-${i}`;
			try {
				const { svg } = await mermaid.render(renderId, src);
				el.innerHTML = svg;
			} catch (err) {
				console.error("Mermaid render failed:", err);
			}
		}
	}

	renderMermaidDiagrams();

	if (!window.__mermaidInitBound) {
		window.__mermaidInitBound = true;
		const onSwupReady = () => {
			window.swup?.hooks?.on("page:view", () => {
				renderMermaidDiagrams();
			});
		};
		if (window.swup?.hooks) {
			onSwupReady();
		} else {
			document.addEventListener("swup:enable", onSwupReady);
		}

		let lastDark = document.documentElement.classList.contains("dark");
		const observer = new MutationObserver(() => {
			const currentDark = document.documentElement.classList.contains("dark");
			if (currentDark !== lastDark) {
				lastDark = currentDark;
				renderMermaidDiagrams();
			}
		});
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});
	}
</script>
