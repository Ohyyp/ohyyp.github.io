---
import Pagination from "@components/custom/Pagination.astro";
import PostListToolbar from "@components/custom/PostListToolbar.astro";
import PostPage from "@components/PostPage.astro";
import { PAGE_SIZE } from "@constants/constants";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategoryList, getSortedPosts } from "@utils/content-utils";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts("en");
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const len = page.data.length;
const categories = await getCategoryList("en");
---

<MainGridLayout lang="en">
    <PostListToolbar categories={categories} lang="en" />
    <PostPage page={page} lang="en"></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} lang="en" style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
