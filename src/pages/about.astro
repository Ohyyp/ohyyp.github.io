---
import { getEntry, render } from "astro:content";
import EmptyState from "@components/custom/EmptyState.astro";
import Markdown from "@components/misc/Markdown.astro";
import { getLocalizedPath } from "@utils/i18n-utils";
import { featurePagesConfig } from "@/config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const locale = "zh_CN";
const aboutPost = featurePagesConfig.about
	? await getEntry("spec", "about-zh")
	: undefined;
const hasBody = Boolean(aboutPost?.body?.trim());
const rendered = aboutPost && hasBody ? await render(aboutPost) : null;
const Content = rendered?.Content;
---
<MainGridLayout title={i18n(I18nKey.about, locale)} description={i18n(I18nKey.about, locale)} lang={locale}>
    {!featurePagesConfig.about ? (
        <EmptyState
            message={i18n(I18nKey.pageDisabled, locale)}
            actionLabel={i18n(I18nKey.backHome, locale)}
            actionHref={getLocalizedPath("/", locale)}
        />
    ) : !Content ? (
        <EmptyState
            message={i18n(I18nKey.noContent, locale)}
            actionLabel={i18n(I18nKey.backHome, locale)}
            actionHref={getLocalizedPath("/", locale)}
        />
    ) : (
        <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
            <div class="card-base z-10 px-9 py-6 relative w-full ">
                <Markdown class="mt-2">
                    <Content />
                </Markdown>
            </div>
        </div>
    )}
</MainGridLayout>
